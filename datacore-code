//Radar for stats
//Radar for stats (SVG - no canvas, avoids Datacore reload errors)
const PixelRadar = ({ stats, maxValue = 10, px = 140, scale = 2 }) => {
  const size = px;
  const cx = size / 2;
  const cy = size / 2;
  const r = size * 0.34;
  const levels = 5;
  const n = stats.length;
  const angleFor = (i) => (Math.PI * 2 * i) / n - Math.PI / 2;
  const pt = (i, value, mul = 1) => {
    const a = angleFor(i);
    const t = Math.max(0, Math.min(1, (value / maxValue))) * mul;
    return [cx + Math.cos(a) * r * t, cy + Math.sin(a) * r * t];
  };

  const gridRings = [];
  for (let lvl = 1; lvl <= levels; lvl++) {
    const mul = lvl / levels;
    const points = [];
    for (let i = 0; i < n; i++) {
      const [x, y] = pt(i, maxValue, mul);
      points.push(`${ x },${ y } `);
    }
    gridRings.push(<polygon key={lvl} points={points.join(" ")} fill="none" stroke="rgba(255,255,255,0.25)" strokeWidth="1" />);
  }

  const axes = [];
  for (let i = 0; i < n; i++) {
    const [x, y] = pt(i, maxValue, 1);
    axes.push(<line key={i} x1={cx} y1={cy} x2={x} y2={y} stroke="rgba(255,255,255,0.25)" strokeWidth="1" />);
  }

  const polyPoints = stats.map((s, i) => pt(i, s.value, 1)).map(([x, y]) => `${ x },${ y } `).join(" ");

  const labels = [];
  for (let i = 0; i < n; i++) {
    const a = angleFor(i);
    const label = String(stats[i]?.code ?? "").toUpperCase();
    const lx = cx + Math.cos(a) * r * 1.22;
    const ly = cy + Math.sin(a) * r * 1.22;
    labels.push(
      <g key={i}>
        <rect x={Math.round(lx) - 12} y={Math.round(ly) - 6} width={24} height={12} fill="rgba(0,0,0,0.45)" />
        <text x={Math.round(lx)} y={Math.round(ly)} textAnchor="middle" dominantBaseline="middle" fill="rgba(255,255,255,0.92)" fontSize="9" fontFamily="monospace">{label}</text>
      </g>
    );
  }

  const points = stats.map((s, i) => {
    const [x, y] = pt(i, s.value, 1);
    const c = STAT_COLORS[s.key] ?? STAT_COLORS.other;
    return <rect key={i} x={Math.round(x) - 2} y={Math.round(y) - 2} width={4} height={4} fill={c} stroke="rgba(0,0,0,0.35)" strokeWidth="1" />;
  });

  return (
    <div style={{ margin: "8px 0 12px", display: "flex", justifyContent: "center" }}>
      <svg width={px * scale} height={px * scale} viewBox={`0 0 ${ size } ${ size } `} style={{ imageRendering: "pixelated", borderRadius: 6, border: "1px solid rgba(255,255,255,0.35)", background: "rgba(0,0,0,0.10)" }}>
        <rect width={size} height={size} fill="rgba(0,0,0,0.10)" />
        {gridRings}
        {axes}
        <polygon points={polyPoints} fill="rgba(125,169,255,0.22)" stroke="rgba(255,255,255,0.75)" strokeWidth="2" />
        {stats.map((s, i) => {
          const sA = s;
          const sB = stats[(i + 1) % n];
          const [x1, y1] = pt(i, sA.value, 1);
          const [x2, y2] = pt((i + 1) % n, sB.value, 1);
          const edgeColor = STAT_COLORS[sA.key] ?? STAT_COLORS.other;
          return <line key={`edge - ${ i } `} x1={x1} y1={y1} x2={x2} y2={y2} stroke={edgeColor} strokeWidth="2" />;
        })}
        {labels}
        {points}
      </svg>
    </div>
  );
};

const getLocalDateString = (date = new Date()) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${ y } -${ m } -${ d } `;
};

function toYMD(v) {
  if (!v) return "";

  // Datacore sometimes returns JS Date objects for YAML dates
  if (v instanceof Date && !Number.isNaN(v.getTime())) {
    return getLocalDateString(v);
  }

  // Luxon DateTime (common in Obsidian ecosystem)
  if (typeof v === "object" && typeof v.toISODate === "function") {
    const iso = v.toISODate();
    return typeof iso === "string" ? iso : "";
  }

  // Fallback: strings (YYYY-MM-DD or ISO datetime)
  const s = String(v).trim();
  if (!s) return "";
  // If it's ISO datetime, keep date part
  if (/^\d{4}-\d{2}-\d{2}T/.test(s)) return s.slice(0, 10);
  // If it's already YYYY-MM-DD
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;

  return s;
}

function toYMDArray(v) {
  if (!Array.isArray(v)) return [];
  return v.map(toYMD).filter(Boolean);
}

function hideFFToast() {
  const el = document.getElementById("gami-ff-toast");
  if (!el) return;
  el.classList.remove("is-open");
  el.setAttribute("aria-hidden", "true");
}

function showFFToast({ title, lines }) {
  const el = document.getElementById("gami-ff-toast");
  if (!el) return;

  const safeTitle = String(title || "Rewards");
  const safeLines = Array.isArray(lines) ? lines.map((s) => String(s)) : [];

  el.innerHTML = `
	< div class="gami-ff-toast-frame" >
      <div class="gami-ff-toast-title">${safeTitle}</div>
      <div class="gami-ff-toast-lines">
        ${safeLines.map((l) => `<div class="gami-ff-toast-line">${l}</div>`).join("")}
      </div>
      <div class="gami-ff-toast-hint">Click to close</div>
    </div >
	`;

  el.onclick = hideFFToast;
  el.classList.add("is-open");
  el.setAttribute("aria-hidden", "false");
}

// helpers for habit modal
function slugifyHabitName(name) {
  return String(name || "habit")
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "") || "habit";
}

async function getSkillMetaByName(skillName) {
  const target = String(skillName || "").trim().toLowerCase();
  if (!target) return null;

  // Reads skills from your vault: SkillTree/Master-Class/Skills/*.md
  const files = app.vault.getFiles().filter(f =>
    f.path.startsWith("SkillTree/Master-Class/Skills/") && f.path.endsWith(".md")
  );

  for (const f of files) {
    try {
      const cache = app.metadataCache.getFileCache(f);
      const fm = cache?.frontmatter || {};
      const nm = String(fm.name || f.basename || "").trim();
      if (nm.toLowerCase() !== target) continue;

      // classPath from frontmatter "class"
      const className = String(fm.class || "").trim();
      const classPath = className ? `SkillTree / Master - Class / Class / ${ className }.md` : "";

      // masterClassPath from the class file (frontmatter master/masterClass), fallback to Jester file if missing
      let masterClassPath = "";
      try {
        const clsFile = classPath ? app.vault.getAbstractFileByPath(classPath) : null;
        if (clsFile) {
          const clsCache = app.metadataCache.getFileCache(clsFile);
          const clsFm = clsCache?.frontmatter || {};
          const masterName = String(clsFm.master || clsFm.masterClass || "").trim();
          if (masterName) masterClassPath = `SkillTree / Master - Class / ${ masterName }.md`;
        }
      } catch {}

      if (!masterClassPath) masterClassPath = "SkillTree/Master-Class/Jester 🎭.md";

      // statPaths from frontmatter stats array
      const stats = Array.isArray(fm.stats) ? fm.stats : (fm.stats ? [fm.stats] : []);
      const statPaths = stats.map(s => `SkillTree / Master - Class / Stats / ${ String(s).trim() }.md`).filter(Boolean);

      return {
        skillName: nm,
        skillPath: f.path,
        classPath,
        masterClassPath,
        statPaths,
        skillColor: String(fm.color || fm.skillColor || "#666666"),
        icon: String(fm.icon || "⭐"),
      };
    } catch {}
  }
  return null;
}

async function createHabitNote({
  name,
  skillName,
  difficulty,
  scheduleType,
  scheduleDays,
  description,
}) {
  const cleanName = String(name || "").trim();
  if (!cleanName) throw new Error("Name is required.");

  const skillMeta = await getSkillMetaByName(skillName);
  if (!skillMeta) throw new Error(`Could not find skill: ${ skillName } `);

  const id = `${ slugifyHabitName(cleanName) }_${ Date.now() } `;
  const path = `SkillTree / Habits / ${ cleanName }.md`;

  // prevent overwrite; add suffix if needed
  let finalPath = path;
  if (app.vault.getAbstractFileByPath(finalPath)) {
    const base = slugifyHabitName(cleanName);
    let i = 2;
    while (app.vault.getAbstractFileByPath(`SkillTree / Habits / ${ base } -${ i }.md`)) i++;
    finalPath = `SkillTree / Habits / ${ base } -${ i }.md`;
  }

  const diff = Math.max(1, Math.min(5, Number(difficulty) || 1));

  // simple reward scaling (same shape as your notes)
  const rewardXP = diff * 10;
  const rewardCP = diff * 5;
  const rewardCoins = diff * 3;

  const created = getLocalDateString();

  const fm = [
    `-- - `,
    `habit: true`,
    `id: "${id}"`,
    `name: "${cleanName.replace(/" / g, '\\"')}"`,
	`emoji: "${skillMeta.icon.replace(/"/g, '\\"')}"`,
	`description: "${String(description || "").replace(/"/g, '\\"')}"`,
	`color: "${skillMeta.skillColor}"`,
	`type: build`,
	`skill: "${skillMeta.skillName.replace(/"/g, '\\"')}"`,
	`skills:`,
	`  - "${skillMeta.skillName.replace(/"/g, '\\"')}"`,
	`skillColor: "${skillMeta.skillColor}"`,
	``,
	`skillPath: "${skillMeta.skillPath.replace(/"/g, '\\"')}"`,
	`classPath: "${skillMeta.classPath.replace(/"/g, '\\"')}"`,
	`masterClassPath: "${skillMeta.masterClassPath.replace(/"/g, '\\"')}"`,
	`statPaths:`,
    ...skillMeta.statPaths.map(p => `  - "${String(p).replace(/"/g, '\\"')}"`),
	``,
	`difficulty: ${diff}`,
	`rewardXP: ${rewardXP}`,
	`rewardCP: ${rewardCP}`,
	`rewardCoins: ${rewardCoins}`,
	`streak: 0`,
	`longestStreak: 0`,
	`lastCompleted: ""`,
	`totalCompletions: 0`,
	`archived: false`,
	`archivedAt: ""`,
	`created: ${created}`,
	`weeklyProgress: [false, false, false, false, false, false, false]`,
	`scheduleType: ${scheduleType === "weekly" ? "weekly" : "daily"}`,
	`scheduleDays: [${(Array.isArray(scheduleDays) && scheduleDays.length ? scheduleDays : [0, 1, 2, 3, 4, 5, 6]).join(", ")}]`,
	`completedDates: []`,
	`treeMilestones: []`,
	`currentTreeStage: 0`,
	`---`,
  ].join("\n");

const body = `\n## ${skillMeta.icon} ${cleanName}\n\n`;
await app.vault.create(finalPath, fm + body);

// optionally open
try { await app.workspace.openLinkText(finalPath, "", true); } catch { }
