								const emoji = page.value("emoji") ?? "⭐";
								const safeId = String(page.$path || name).replace(/[^a-zA-Z0-9_-]/g, "_");

								async function setSortOrderForPath(path, nextOrder) {
									const file = app.vault.getAbstractFileByPath(path);
									if (!file) return;
									await app.fileManager.processFrontMatter(file, (fm) => {
										fm.sortOrder = nextOrder;
									});
								}
								const isArchived = page.value("archived") === true;
								const skillsVal = page.value("skills");
								const skills = Array.isArray(skillsVal) ? skillsVal : [];
								const skill =
									page.value("skill") ??
									skills[0] ??
									"Unknown";

								const skillColor = page.value("skillColor") ?? page.value("color") ?? "#3b82f6";

								const streak = Number(page.value("streak") ?? 0);
								const best = Number(page.value("longestStreak") ?? streak);

								const milestonesRaw = page.value("treeMilestones");
								const milestones = Array.isArray(milestonesRaw) ? milestonesRaw : [];

								const currentStageObj =
									milestones
										.filter(m => Number(m?.streakRequired ?? 0) <= streak)
										.sort((a, b) => Number(b.streakRequired ?? 0) - Number(a.streakRequired ?? 0))[0]
									?? null;

								const nextStageObj =
									milestones
										.filter(m => Number(m?.streakRequired ?? 0) > streak)
										.sort((a, b) => Number(a.streakRequired ?? 0) - Number(b.streakRequired ?? 0))[0]
									?? null;

								const currentStageNum = Number(currentStageObj?.stage ?? page.value("currentTreeStage") ?? 0);

								const treePath = TREE_STAGE_TO_PATH[currentStageNum] || TREE_STAGE_TO_PATH[0];
								const treeFile = treePath ? app.vault.getAbstractFileByPath(treePath) : null;
								const treeImgSrc = treeFile ? app.vault.getResourcePath(treeFile) : "";
								const nextRequired = Number(nextStageObj?.streakRequired ?? 0);
								const daysToNext = nextStageObj ? Math.max(0, nextRequired - streak) : 0;

								// simple “level”: stage + 1 (matches your screenshot style)
								const treeLevel = currentStageNum + 1;

								// simple “tree bonus”: 7-day tiers (easy + matches your earlier streak bonus idea)
								const treeBonus = Math.floor(streak / 7) + 1;

								const difficulty = Number(page.value("difficulty") ?? 1);
								const diffLabel =
									difficulty === 1 ? "Easy" :
										difficulty === 2 ? "Medium" :
											difficulty === 3 ? "Hard" :
												`★ x${difficulty}`;

								const rewardXP = Number(page.value("rewardXP") ?? 0);
								const rewardCP = Number(page.value("rewardCP") ?? 0);
								const rewardBoogers = Number(page.value("rewardCoins") ?? 0);

								// Optional: body/description
								const description = page.value("description") ?? "";

								const today = getLocalDateString();

								async function markHabitCompleteOnce() {
									const path = page.$path;
									if (!path) return;

									const file = app.vault.getAbstractFileByPath(path);
									if (!file) return;

									const content = await app.vault.read(file);

									// Find YAML frontmatter
									const match = content.match(/^---\n([\s\S]*?)\n---\n?/);
									if (!match) return;

									const fmText = match[1];
									const body = content.slice(match[0].length);

									// Very small YAML update helpers (string-based)
									const hasToday = new RegExp(`^\\s*-\\s*"${today}"\\s*$`, "m").test(fmText);
									const hasCompletedDatesKey = /^completedDates:\s*$/m.test(fmText);

									// If already completed today, do nothing (you said "mark complete only")
									if (hasToday || new RegExp(`^lastCompleted:\\s*"?${today}"?\\s*$`, "m").test(fmText)) return;

									let nextFm = fmText;

									// Update lastCompleted (add or replace)
									if (/^lastCompleted:/m.test(nextFm)) {
										nextFm = nextFm.replace(/^lastCompleted:.*$/m, `lastCompleted: "${today}"`);
									} else {
										nextFm += `\nlastCompleted: "${today}"\n`;
									}

									// Append today to completedDates (create key if missing)
									if (hasCompletedDatesKey) {
										nextFm = nextFm.replace(/^completedDates:\s*$/m, `completedDates:\n  - "${today}"`);
									} else if (/^completedDates:\s*\n/m.test(nextFm)) {
										// Key exists with list entries; append a new line item
										nextFm = nextFm.replace(/^completedDates:\s*\n([\s\S]*?)(\n(?!\s*-)|$)/m, (full, listBlock, tail) => {
											return full.replace(/\s*$/, `  - "${today}"\n`) + (tail || "");
										});
									} else {
										nextFm += `\ncompletedDates:\n  - "${today}"\n`;
									}

									const updated = `---\n${nextFm}\n---\n${body}`;
									await app.vault.modify(file, updated);
								}

								const lastCompleted = toYMD(page.value("lastCompleted")) || "—";

								const isCompletedToday =
									toYMD(page.value("lastCompleted")) === today ||
									toYMDArray(page.value("completedDates")).includes(today);


								async function setArchived(nextArchived) {
									const path = page.$path;
									if (!path) return;
									const file = app.vault.getAbstractFileByPath(path);
									if (!file) return;

									const menu = document.getElementById(`habit-menu-${safeId}`);
									if (menu) menu.checked = false;

									try {
										await app.fileManager.processFrontMatter(file, (fm) => {
											fm.archived = nextArchived;
											if (nextArchived) fm.archivedAt = today;
											else delete fm.archivedAt;
										});
									} catch (e) {
										// fallback: string-edit YAML
										// ... (kept in your file)
									}

									const card = document.getElementById(`habit-card-${safeId}`);
									if (card) {
										if (nextArchived && habitTab !== "archived") card.style.display = "none";
										if (!nextArchived && habitTab === "archived") card.style.display = "none";
									}

									try { showFFToast({ title: nextArchived ? "Habit archived" : "Habit restored", lines: [name] }); } catch { }
								}

								const scheduleType = String(page.value("scheduleType") ?? "daily");
								const scheduleDays = Array.isArray(page.value("scheduleDays")) ? page.value("scheduleDays") : [];
								const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
								const scheduleLabel =
									scheduleType === "weekly" && scheduleDays.length
										? scheduleDays.map(d => dayNames[Number(d)]).filter(Boolean).join(", ")
										: "";
								return (
									<div
										className="habit-card"
										id={`habit-card-${safeId}`}
										key={page.$path ?? name}
										draggable
										onDragStart={(e) => {
											e.dataTransfer.setData("text/plain", String(page.$path || ""));
											e.dataTransfer.effectAllowed = "move";
										}}
										onDragOver={(e) => {
											e.preventDefault(); // allow drop
											e.dataTransfer.dropEffect = "move";
										}}
										onDrop={async (e) => {
											e.preventDefault();
											const fromPath = e.dataTransfer.getData("text/plain");
											const toPath = String(page.$path || "");
											if (!fromPath || !toPath || fromPath === toPath) return;

											// compute new order based on target’s current order
											const targetOrderRaw = Number(page.value("sortOrder"));
											const targetOrder = Number.isFinite(targetOrderRaw) ? targetOrderRaw : idx;

											// Put dragged item just above the target (simple + predictable)
											const newOrder = targetOrder - 0.5;

											await setSortOrderForPath(fromPath, newOrder);

											try { showFFToast({ title: "Reordered", lines: [] }); } catch { }
										}}>
										<div className="habit-card-main">
											<div className="habit-card-left">
												<div className="habit-icon">
													<span className="habit-icon-check">{emoji}</span>
												</div>

												<div className="habit-text">
													<div className="habit-title">{name}</div>

													<div className="habit-meta">
														<span
															className="habit-tag habit-tag-skill"
															style={{ background: `${skillColor}66` }}>
															Skill: {skill}
														</span>

														<span className="habit-tag habit-tag-streak">Streak: {streak}</span>
														<span className="habit-tag habit-tag-streak">Best: {best}</span>

														<span className="habit-tag habit-tag-difficulty">
															Difficulty: {diffLabel}
														</span>

														{scheduleLabel && (
															<span className="habit-tag habit-tag-schedule">📅 {scheduleLabel}</span>
														)}
													</div>

													{/* description now lives under the tags */}
													<div className="habit-description">{description}</div>
												</div>
											</div> {/* end of habit-card-left*/}

											<div className="gami-habit-actions">
												<div className="gami-habit-rewards">
													<div className="gami-habit-reward-xp">+{rewardXP} XP</div>

													{/* CP: no class yet; inline style to match your palette */}
													<div style={{ color: "#67e8f9", fontWeight: 600 }}>+{rewardCP} CP</div>

													{/* use the existing CSS class you already defined */}
													<div className="habit-reward-boogers">+{rewardBoogers} Boogers</div>
												</div>

												{isCompletedToday ? (
													<button className="gami-habit-action-btn gami-habit-action-done" disabled>
														DONE
													</button>
												) : (
													<button
														className="gami-habit-action-btn gami-habit-action-complete"
														onClick={async (evt) => {
															const btn = evt.currentTarget;
															btn.disabled = true;

															await markHabitCompleteOnce();

															// instant UI feedback
															btn.textContent = "DONE";
															btn.classList.remove("gami-habit-action-complete");
															btn.classList.add("gami-habit-action-done");

															// FF toast
															try {
																showFFToast({
																	title: "Rewards",
																	lines: [`+${rewardXP} XP`, `+${rewardCP} CP`, `+${rewardBoogers} Boogers`],
																});
															} catch { }
														}}>
														Complete
													</button>
												)}

												<button
													className="gami-habit-action-btn gami-habit-action-tree"
													onClick={() => {
														const t = document.getElementById(`habit-tree-${safeId}`);
														if (t) t.checked = true;
													}}>
													View Tree
												</button>

												<input
													type="checkbox"
													id={`habit-tree-${safeId}`}
													className="gami-tree-toggle"
												/>

												<div className="gami-tree-backdrop">
													<div className="gami-tree-modal">
														<div className="gami-tree-header">
															<div className="gami-tree-title">🌳 Tree Growth</div>
															<div className="gami-tree-stage-badge">Stage {currentStageNum}</div>
															<label htmlFor={`habit-tree-${safeId}`} className="gami-tree-close">✕</label>
														</div>

														<div className="gami-tree-body">
															<div className="gami-tree-image-frame">
																{treeImgSrc ? (
																	<img className="gami-tree-image" src={treeImgSrc} alt="Tree" />
																) : (
																	<div className="gami-tree-image-missing">Missing tree image</div>
																)}
															</div>

															<div className="gami-tree-badges">
																<div className="gami-tree-badge">Lv. {treeLevel}</div>
																<div className="gami-tree-badge">{daysToNext} days to next stage</div>
																<div className="gami-tree-badge">Tree Bonus x{treeBonus}</div>
															</div>
														</div>
													</div>
												</div> {/* end of gami tree backdrop */}



												{/* overflow menu toggle (checkbox hack) */}



												{/*dropdown box for the option button */}
												<input
													type="checkbox"
													id={`habit-menu-${safeId}`}
													className="gami-habit-menu-toggle"
												/>

												<label
													htmlFor={`habit-menu-${safeId}`}
													className="gami-habit-menu-btn"
													title="Options">
													…
												</label>

												<div className="gami-habit-menu">
													<button
														type="button"
														className="gami-habit-menu-item"
														onClick={() => {
															const el = document.getElementById(`habit-menu-${safeId}`);
															if (el) el.checked = false;
														}}>
														✅ Complete
													</button>

													<a
														className="gami-habit-menu-item"
														href={encodeURI(page.$path)}
														onClick={() => {
															const el = document.getElementById(`habit-menu-${safeId}`);
															if (el) el.checked = false;
														}}>
														✏️ Edit
													</a>

													<button
														type="button"
														className="gami-habit-menu-item"
														onClick={() => {
															setArchived(!isArchived);
														}}>
														{isArchived ? "↩️ Unarchive" : "📦 Archive"}
													</button>

													<button
														type="button"
														className="gami-habit-menu-item gami-habit-menu-item-danger"
														onClick={() => {
															const menu = document.getElementById(`habit-menu-${safeId}`);
															if (menu) menu.checked = false;
															const del = document.getElementById(`habit-delete-${safeId}`);
															if (del) del.checked = true;
														}}>
														🗑️ Delete
													</button>
												</div>

												{/* DELETE CONFIRM */}
												<input
													type="checkbox"
													id={`habit-delete-${safeId}`}
													className="gami-delete-toggle"
												/>

												<div className="gami-delete-backdrop">
													<div className="gami-delete-modal">
														<div className="gami-delete-header">
															<div className="gami-delete-title">Delete Habit</div>
															<label
																htmlFor={`habit-delete-${safeId}`}
																className="gami-delete-close"
																title="Close">
																✕
															</label>
														</div>

														<div className="gami-delete-body">
															<div className="gami-delete-icon">☠️</div>

															<div className="gami-delete-box">
																<div className="gami-delete-text">
																	Are you sure you want to delete <strong>{name}</strong>?
																	<br />
																	All streak and history data will be permanently lost.
																</div>

																<div className="gami-delete-warning">
																	This action cannot be undone!
																</div>
															</div>
														</div>

														<div className="gami-delete-footer">
															<label
																htmlFor={`habit-delete-${safeId}`}
																className="gami-delete-btn gami-delete-btn-keep">
																Keep
															</label>

															<button
																className="gami-delete-btn gami-delete-btn-delete"
																onClick={async () => {
																	const path = page.$path;
																	if (!path) return;

																	const file = app.vault.getAbstractFileByPath(path);
																	if (!file) return;

																	try {
																		await app.vault.delete(file);

																		// close delete modal
																		const del = document.getElementById(`habit-delete-${safeId}`);
																		if (del) del.checked = false;

																		// hide card immediately
																		const card = document.getElementById(`habit-card-${safeId}`);
																		if (card) card.style.display = "none";

																		try {
																			showFFToast({ title: "Habit deleted", lines: [name] });
																		} catch { }
																	} catch (e) {
																		try {
																			showFFToast({ title: "Delete failed", lines: [String(e?.message || e)] });
																		} catch { }
																	}
																}}>
																Delete
															</button>

														</div>
													</div>
												</div> {/* end of gami-delete-backdrop*/}
											</div> {/* end of gami-habit-actions*/}
										</div> {/* end of habit-card-main*/}

										<div className="habit-footer">
											<div className="habit-footer-meta">
												{toYMD(page.value("lastCompleted")) === today ? "Completed" : "Not completed"}
											</div>
										</div> {/*end of habit footer */}
									</div> /* end of habit-card-left*/
								);
							})} {/* end of habits.map*/}
						</div>{/* end of habit list */}
						<label htmlFor="gami-add-habit-toggle" className="habits-add-bottom">
							＋ Add Habit
						</label>
					</div> {/* end gami-sections for habits */}
				</div>{/* end gami-sections */}
			</div> {/*end of gami-dash all content doesnt leave beyond here */}

		</>
	);
} /* end of the return div */

