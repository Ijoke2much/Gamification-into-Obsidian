{
	"name": "gamified-obsidian-plugin",
	"version": "1.0.0",
	"description": "Gamify your Obsidian vault with quests, achievements, boss battles, and RPG-style progression",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "echo '🔧 Running TypeScript check...' && tsc -noEmit -skipLibCheck && echo '📦 Building with esbuild...' && node esbuild.config.mjs production && echo '✅ Build completed!' && npm run build:verify",
		"build:sync": "npm run build && npm run publish:icloud",
		"build:verify": "node scripts/verify-plugin-build.mjs",
		"assets:copy": "node scripts/copy-plugin-assets.mjs",
		"publish:icloud": "node scripts/publish-to-icloud-vault.mjs",
		"build:analyze": "npm run build && node scripts/analyze-bundle.mjs",
		"verify-dialogue": "node scripts/verify-shopkeeper-dialogue.js",
		"analyze": "node scripts/analyze-bundle.mjs",
		"preview:pixel-boss": "node scripts/open-pixel-preview.js",
		"preview:pixel-boss:serve": "npx --yes serve preview -l 4177",
		"preview:journey": "node scripts/open-journey-preview.js",
		"preview:journey:serve": "npx --yes serve preview -l 4178",
		"preview:journey-hub": "node scripts/open-journey-hub-preview.js",
		"preview:projects": "node scripts/open-projects-preview.js",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"gamification",
		"productivity",
		"rpg",
		"quests",
		"achievements"
	],
	"author": "Niles Loverso",
	"license": "MIT",
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.14.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.8",
		"esbuild-css-modules-plugin": "^3.1.5",
		"esbuild-plugin-copy": "^2.1.1",
		"obsidian": "latest",
		"tslib": "^2.8.0",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.1.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1"
	}
}
